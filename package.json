{
  "name": "clip",
  "version": "1.0.0",
  "description": "Tiny clipboard sync daemon for macOS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "status": "curl -s http://localhost:4545/status | python3 -m json.tool",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "msw": "^2.15.0",
    "vitest": "^4.1.10"
  }
}
