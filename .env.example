# Copy to .env and fill in for this machine. All vars are optional at boot -
# CLIP_TOKEN is auto-generated into .env on first run if you leave it unset,
# but you MUST set CLIP_PEER and CLIP_TOKEN (the same value on both machines)
# for sync to actually connect two machines together.
CLIP_NAME=
CLIP_PORT=4545
CLIP_PEER=
CLIP_TOKEN=
CLIP_POLL_MS=400
CLIP_MAX_BYTES=102400
CLIP_DB_PATH=

# Optional - only needed for the "send clip to Stickies" button.
STICKIES_API_URL=http://localhost:4444
