<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bunlong.clip</string>

    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/node</string>
        <string>/ABSOLUTE/PATH/TO/clip/src/server.js</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CLIP_NAME</key>
        <string>MyMac</string>
        <key>CLIP_PEER</key>
        <string>192.168.1.50:4545</string>
        <!-- Leave CLIP_TOKEN unset to auto-generate one into .env on first run,
             or set it here to the SAME value used on the other machine. Never
             leave this as a hardcoded placeholder - config.js refuses to run
             with a known-public default and will generate its own instead. -->
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- launchd does not expand ~ - use your real home dir, e.g.
         /Users/yourname/Library/Logs/clip.log. That path persists across
         reboots and is not world-writable, unlike /tmp which macOS clears
         on every restart. -->
    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/HOME/Library/Logs/clip.log</string>

    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/HOME/Library/Logs/clip.err</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
